# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Project Settings -> API). La "anon key" es pública por diseño: la seguridad
# real está en las políticas RLS de supabase/migrations. NUNCA pongas aquí la
# service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave pública VAPID para notificaciones push (opcional)
VITE_VAPID_PUBLIC_KEY=
# SEO: dominio público sin "/" final (URLs canónicas, sitemap y vista previa
# al compartir el enlace). Ej: https://nuestro-rincon.netlify.app
VITE_SITE_URL=
# Pon "false" para que ningún buscador indexe el sitio aunque sea público.
VITE_SEO_INDEX=true

# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Project Settings -> API). La "anon key" es pública por diseño: la seguridad
# real está en las políticas RLS de supabase/migrations. NUNCA pongas aquí la
# service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave pública VAPID (opcional: si se deja vacía, la app la pide a la función
# send-push, que la crea el flujo Deploy)
VITE_VAPID_PUBLIC_KEY=
# CAPTCHA contra bots (opcional): clave pública ("Site key") de Cloudflare
# Turnstile. La secreta va como TURNSTILE_SECRET_KEY en los secretos de GitHub
# (ver docs/DESPLIEGUE.md). Vacía: sin CAPTCHA.
VITE_TURNSTILE_SITE_KEY=
# SEO: dominio público sin "/" final (URLs canónicas, sitemap y vista previa
# al compartir el enlace). Ej: https://nuestro-rincon.netlify.app
VITE_SITE_URL=
# Pon "false" para que ningún buscador indexe el sitio aunque sea público.
VITE_SEO_INDEX=true
# Donación voluntaria (opcional): enlace https a Ko-fi, Buy Me a Coffee, GitHub
# Sponsors, PayPal… Muestra «Invítame un café» en el pie. Vacía: sin botón.
VITE_DONATION_URL=
# App en Google Play (opcional, ver docs/APP_CELULAR.md). No son VITE_: el
# build las usa para publicar /.well-known/assetlinks.json y no llegan al JS.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

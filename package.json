{
  "name": "camila-love-app",
  "private": true,
  "version": "2.0.0",
  "description": "Aplicación web privada para una pareja: recuerdos, fechas especiales, chat en tiempo real y listas compartidas, con panel de administración. React, TypeScript y Supabase.",
  "homepage": "https://camila-sanchez.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juan-Carlos-Estevez-Vargas/Camila-Sanchez.git"
  },
  "bugs": {
    "url": "https://github.com/Juan-Carlos-Estevez-Vargas/Camila-Sanchez/issues"
  },
  "author": "Juan Carlos Estevez Vargas (https://github.com/Juan-Carlos-Estevez-Vargas)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:setup-sql": "node scripts/build-setup-sql.mjs",
    "release:preview": "node scripts/release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "idb-keyval": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sass-embedded": "^1.106.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
